VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Dev only (npm run dev): open a role's pages without logging in.
# One of: owner | branch_manager | sales. Remove this line to use the real login.
# VITE_DEV_ROLE=owner

# NEVER put the service_role / secret key here. Any VITE_ variable is visible in the browser.
